{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!packages/coding-agent/src/bundled-skills.generated.ts",
			"!packages/tools/test/fixtures/repomap",
			"!**/.labunbun/skills/**/*.js"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "off"
			}
		}
	},
	"markdown": {
		"formatter": {
			"enabled": false
		}
	},
	"assist": {
		"actions": { "source": { "organizeImports": "on" } }
	}
}
