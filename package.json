{
	"name": "labunbun",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"bun": ">=1.4.4"
	},
	"scripts": {
		"dev": "bun run packages/coding-agent/src/main.ts",
		"typecheck": "tsc -p tsconfig.check.json",
		"test": "bun test",
		"lint": "biome check --error-on-warnings .",
		"fmt": "biome format --write .",
		"bin:build": "bun build --compile --minify packages/coding-agent/src/main.ts --outfile dist/labunbun-x64.exe",
		"installer:build": "bun run scripts/build-installer.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@types/bun": "^1.3.0",
		"typescript": "^6.0.3"
	},
	"license": "MIT",
	"workspaces": [
		"packages/*"
	]
}
