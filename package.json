{
	"name": "labunbun",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"bun": ">=1.4.4"
	},
	"scripts": {
		"dev": "bun run packages/coding-agent/src/main.ts",
		"typecheck": "tsc -p tsconfig.check.json",
		"test": "bun test --timeout=30000",
		"test:coverage": "bun test --timeout=30000 --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
		"repomap:bench": "bun run scripts/repomap-bench.ts",
		"repomap:grammars": "bun run scripts/build-repomap-grammars.ts",
		"lint": "biome check --error-on-warnings .",
		"fmt": "biome format --write .",
		"skills:bundle": "bun run scripts/bundle-skills.ts",
		"bin:build": "bun run scripts/bundle-skills.ts && bun build --compile --minify --windows-icon=docs/assets/labunbun-icon.ico --windows-title=\"LaBunbun Code\" --windows-description=\"LaBunbun Code\" --windows-publisher=zayokami --windows-version=0.1.0.4 --windows-copyright=\"Copyright (c) 2026 zayoka\" packages/coding-agent/src/main.ts packages/tools/src/repomap-worker.ts --outfile dist/labunbun-x64.exe",
		"installer:build": "bun run scripts/build-installer.ts",
		"release:package": "bun run scripts/package-release.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@types/bun": "^1.4.4",
		"typescript": "^6.0.3"
	},
	"license": "MIT",
	"workspaces": [
		"packages/*"
	]
}
